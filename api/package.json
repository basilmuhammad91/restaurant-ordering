{
  "name": "api",
  "version": "1.0.0",
  "description": "Restaurant ordering API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "create-admin": "tsx scripts/create-admin.ts",
    "db:seed": "tsx scripts/seed.ts",
    "predev": "npm run build -w @restoflux/contracts",
    "pretest": "npm run build -w @restoflux/contracts",
    "pretypecheck": "npm run build -w @restoflux/contracts",
    "prebuild": "npm run build -w @restoflux/contracts",
    "create-platform-admin": "tsx scripts/create-platform-admin.ts",
    "create-tenant": "tsx scripts/create-tenant.ts",
    "bootstrap:default-tenant": "tsx scripts/bootstrap-default-tenant.ts",
    "seed:demo-orders": "tsx scripts/seed-demo-orders.ts",
    "seed:demo-menu": "tsx scripts/seed-demo-menu.ts",
    "seed:demo-ops": "tsx scripts/seed-demo-ops.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "test:cleanup": "tsx scripts/purge-test-tenants.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.7.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7",
    "@restoflux/contracts": "*"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "prisma": "^7.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
